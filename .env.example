VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
# Optional bootstrap token. The app stores and refreshes the live token in Supabase after first use.
TWITCH_BOT_ACCESS_TOKEN=
# Recommended for production. Used to refresh the bot token automatically when it expires.
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=
GROQ_API_KEY=
# Structured output mode: "strict" uses Groq json_schema (highest reliability, lowest model choice).
# "best_effort" allows non-json_schema models and relies on local validation/retries.
GROQ_STRUCTURED_OUTPUT_MODE=strict
# Recommended strict structured-output model for automated case generation.
GROQ_CASE_MODEL=openai/gpt-oss-20b
# Optional comma-separated fallback list. In strict mode only json_schema-capable models are valid.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
ADMIN_PASSWORD=
PORT=3001
